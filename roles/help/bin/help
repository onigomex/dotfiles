#!/usr/bin/env zsh

# 自分がよく忘れることを書いておいて、サッと見れるための help
# 中身は何でも良い。特に決めてない。よく使うコマンド、忘れがちなコマンドとか。


main() {
cat << 'EOF'
# Commands
- gci: git commit id を表示する（fzf で絞り込める）。
- gcd: git リポジトリの top レベルに移動する。
- gbr: git-branch-list
- gpn: github-pull-request-no
- git-unstage: 'git reset HEAD'
- k: kubectl
- repo: src 直下を fzf し、選択したら cd
- c: リポジトリを fzf で選び、herdr に「左 claude（hello 送信済み）/ 右ターミナル」の
     ワークスペースを開く（herdr-claude-workspace）。herdr 上なら prefix+c でも同じ。
- zi: 高アクセス頻度dir を fzf し、選択したら cd
- z <ディレクトリ断片>: z 移動したいディレクトリの断片（e.g., z D => cd ~/Download）
- aws-nuke: aws nuke
- gci-rebase: rebase 用の git commit id（選んだ一つ前）を出力する
- ssh-add-keys: ~/.ssh/*.pem ファイルを ssh-add する
- tmux-resize-pane: tmux の pane サイズを変更する
- claude -c: --continue の略、直近の会話の継続する
- claude -r: --resume の略、特定のセッションを再開する
- claude -w [name]: --worktree の略、.claude/worktrees/<name> に隔離された Git Worktree で起動する
EOF
}

main
