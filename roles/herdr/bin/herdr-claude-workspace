#!/usr/bin/env zsh

# herdr-claude-workspace - pick a repository and open a herdr workspace laid out for work:
# claude on the left, a plain terminal on the right.
#
# Deliberately minimal: it opens the workspace and gets out of the way. It does not send
# a first prompt and takes no arguments - type whatever you want once the workspace is up.
# The earlier version submitted a prompt for you and cost 3.96s, because sending a prompt
# means blocking until claude is ready to accept input. This one returns in ~0.3s and
# claude boots in front of you. See roles/herdr/README.md for how to get that version back.
#
# If a workspace for the chosen repository already exists, it is focused instead of
# creating a second one (two workspaces on the same checkout is a recipe for losing
# track of which one you were working in). To work on the same repository in parallel,
# make a git worktree and open that.

set -eu

readonly SHELL_READY_TIMEOUT_MS=10000

usage() {
  cat <<EOF
Usage: herdr-claude-workspace

Pick a ghq repository with fzf and open a herdr workspace for it:
  * left pane  ... claude
  * right pane ... a plain terminal in the same directory

Takes no arguments. Type your first prompt yourself once claude is up.

Notes:
  * Must run inside a herdr session (it talks to the herdr server over its socket API).
  * If the repository already has a workspace, that workspace is focused and nothing
    else happens.
EOF
}

require() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      print -u2 "herdr-claude-workspace: '$cmd' is required but was not found in PATH."
      return 1
    }
  done
}

# Echo the repository chosen with fzf, or nothing when the user cancels.
select_repository() {
  local root target
  root="$(ghq root)"
  target="$(ghq list | sort | uniq \
    | fzf -0 --inline-info --ansi --cycle \
          --prompt 'claude workspace> ' \
          --preview "ls -la $root/{}")" || return 0
  [[ -n "$target" ]] && print -r -- "$root/$target"
}

# Wait until <pane> is sitting at an idle shell prompt, so the command we type into it
# is not lost to a shell that is still running its startup. The shell is idle once it is
# its own foreground process group.
wait_for_shell() {
  local pane="$1" i
  for (( i = 0; i < SHELL_READY_TIMEOUT_MS / 100; i++ )); do
    herdr pane process-info --pane "$pane" \
      | jq -e '.result.process_info
               | .shell_pid != null and .shell_pid == .foreground_process_group_id' \
        >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  print -u2 "herdr-claude-workspace: pane $pane never settled at a shell prompt."
  return 1
}

# Echo the id of an existing workspace whose pane sits in <dir>, or nothing.
find_workspace() {
  herdr pane list \
    | jq -r --arg cwd "$1" '.result.panes[] | select(.cwd == $cwd) | .workspace_id' \
    | head -n 1
}

open_workspace() {
  local dir="$1"
  local created workspace left

  # Nothing here may move the focus until the very last step. Focus changes tear down
  # the popup this script runs in, and anything left undone would be lost with it.
  created="$(herdr workspace create --cwd "$dir" --no-focus)"
  workspace="$(print -r -- "$created" | jq -r '.result.workspace.workspace_id')"
  left="$(print -r -- "$created" | jq -r '.result.root_pane.pane_id')"

  herdr pane split "$left" --direction right --ratio 0.5 --cwd "$dir" --no-focus >/dev/null

  # 'pane run' just types the command and returns; claude boots in the workspace we are
  # about to focus, in full view, instead of behind a popup you have to wait on.
  wait_for_shell "$left"
  herdr pane run "$left" claude >/dev/null

  herdr workspace focus "$workspace" >/dev/null
}

main() {
  case "${1:-}" in
    -h|--help) usage; return 0 ;;
  esac
  if (( $# > 0 )); then
    print -u2 "herdr-claude-workspace: takes no arguments."
    usage >&2
    return 1
  fi

  require herdr ghq fzf jq

  # Name the terminal so the popup shows what it is. [[keys.command]] has no title
  # option (reload reports 'unknown config key keys.command.0.title'), so the only
  # handle is the OSC 0 title the terminal itself reports.
  print -n "\e]0;claude workspace\a"

  local dir existing

  dir="$(select_repository)"
  [[ -n "$dir" ]] || return 0

  existing="$(find_workspace "$dir")"
  if [[ -n "$existing" ]]; then
    herdr workspace focus "$existing" >/dev/null
    return 0
  fi

  open_workspace "$dir"
}

main "$@"
